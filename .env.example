# ─────────────────────────────────────────────────────────────────────────────
# Water Finder — variables d'environnement (modèle)
# Copier vers `apps/mobile/.env` (développement local) puis renseigner.
# Ne JAMAIS committer de fichier .env réel : seuls les .env.example sont versionnés.
#
# Règle de sécurité : toute variable préfixée EXPO_PUBLIC_ est intégrée au bundle
# de l'application et donc PUBLIQUE. Aucune clé secrète ne doit l'être.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application (phase 1) ────────────────────────────────────────────────────
# Environnement : development | staging | production
APP_ENV=development

# Identifiant de base iOS / Android (suffixe .dev / .staging ajouté automatiquement).
# ⚠️ À confirmer avant la première soumission : non modifiable après publication.
APP_BUNDLE_ID=com.waterfinder.app

# Compte Expo propriétaire du projet et identifiant EAS (fournis par `eas init`).
EXPO_OWNER=
EAS_PROJECT_ID=

# ── Carte (phase 1) ──────────────────────────────────────────────────────────
# Style MapLibre (URL d'un style JSON). Par défaut : OpenFreeMap « liberty ».
# Conditions d'utilisation à valider avant la production (voir DATA_SOURCES.md).
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Style optionnel pour le thème sombre (vide = même style qu'en clair).
EXPO_PUBLIC_MAP_STYLE_URL_DARK=
# Police des étiquettes de groupes : doit exister sur le serveur de glyphes du style.
EXPO_PUBLIC_MAP_FONT=Noto Sans Bold

# Données FICTIVES de démonstration (développement uniquement, bandeau permanent).
# Refusé à la compilation si APP_ENV=production.
EXPO_PUBLIC_DEMO_DATA=false

# ── Backend Supabase (phase 2) ───────────────────────────────────────────────
# URL du projet et clé publique (anon / publishable) : publiques par nature,
# la sécurité repose sur les règles RLS de PostgreSQL.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ⛔ SECRET — serveur uniquement (ETL, administration). Jamais dans l'application mobile,
# jamais préfixé EXPO_PUBLIC_. Stocker dans les secrets GitHub Actions / Vercel / EAS.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── Publicité AdMob (phase 6) ────────────────────────────────────────────────
# Identifiants d'application AdMob (publics, intégrés au binaire natif).
# Laisser vide : les identifiants de TEST officiels de Google seront utilisés.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
# Identifiants de blocs d'annonces (bannière adaptative, native).
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_NATIVE_ANDROID=
EXPO_PUBLIC_ADMOB_NATIVE_IOS=

# ── Administration web Next.js (phase 7) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
